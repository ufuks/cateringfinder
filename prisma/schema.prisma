generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { GUEST CUSTOMER COMPANY ADMIN SUPER_ADMIN MODERATOR SUPPORT }
enum CompanyStatus { PENDING ACTIVE SUSPENDED REJECTED }
enum ListingStatus { DRAFT PENDING_REVIEW APPROVED REJECTED SUSPENDED }
enum LeadStatus { OPEN MATCHED QUOTED ACCEPTED CLOSED }
enum QuoteStatus { DRAFT SENT VIEWED ACCEPTED REJECTED EXPIRED CANCELLED }
enum SubscriptionStatus { TRIALING ACTIVE PAST_DUE GRACE_PERIOD CANCELLED EXPIRED SUSPENDED }
enum ReviewStatus { PENDING APPROVED REJECTED FLAGGED }
enum NotificationType { NEW_LEAD NEW_QUOTE QUOTE_VIEWED QUOTE_ACCEPTED NEW_MESSAGE NEW_REVIEW REVIEW_RESPONSE SUBSCRIPTION_EXPIRING PAYMENT_FAILED PROFILE_APPROVED LISTING_APPROVED CUSTOMER_REQUEST_MATCHED }

a model User { id String @id @default(cuid()) email String @unique passwordHash String? name String phone String? role UserRole @default(CUSTOMER) emailVerifiedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt customerProfile CustomerProfile? companyUsers CompanyUser[] notifications Notification[] notificationPreference NotificationPreference? favoritesCompany FavoriteCompany[] favoritesListing FavoriteListing[] messages Message[] auditLogs AuditLog[] leads Lead[] quotes Quote[] conversations ConversationParticipant[] blogPosts BlogPost[] supportTickets SupportTicket[] }
model CustomerProfile { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId], references:[id], onDelete:Cascade) cityId String? districtId String? bio String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Company { id String @id @default(cuid()) name String slug String @unique status CompanyStatus @default(PENDING) verified Boolean @default(false) description String? foundedYear Int? cityId String? districtId String? address String? latitude Float? longitude Float? capacity Int? responseMinutes Int? rating Float @default(0) reviewCount Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? users CompanyUser[] profile CompanyProfile? listings Listing[] subscriptions CompanySubscription[] leads LeadCompanyMatch[] quotes Quote[] reviews Review[] reviewReplies ReviewReply[] suppliers ListingSupplier[] favorites FavoriteCompany[] categories CompanyCategory[] googlePlace GooglePlace? yandexPlace YandexPlace? externalReviews ExternalReview[] payments Payment[] invoices Invoice[] }
model CompanyUser { companyId String userId String role String @default("OWNER") company Company @relation(fields:[companyId], references:[id], onDelete:Cascade) user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@id([companyId,userId]) }
model CompanyProfile { id String @id @default(cuid()) companyId String @unique company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) logoUrl String? coverUrl String? website String? services Json? cuisines Json? serviceAreas Json? paymentOptions Json? completeness Int @default(0) seoTitle String? seoDescription String? updatedAt DateTime @updatedAt }
model Category { id String @id @default(cuid()) name String slug String @unique active Boolean @default(true) listings Listing[] companies CompanyCategory[] }
model CompanyCategory { companyId String categoryId String company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) category Category @relation(fields:[categoryId],references:[id],onDelete:Cascade) @@id([companyId,categoryId]) }
model Service { id String @id @default(cuid()) name String slug String @unique active Boolean @default(true) listings ListingService[] }
model Listing { id String @id @default(cuid()) companyId String categoryId String? cityId String? title String slug String @unique subtitle String? description String? status ListingStatus @default(DRAFT) priceFrom Decimal? priceType String? minPeople Int? maxPeople Int? setup Boolean @default(false) staff Boolean @default(false) delivery Boolean @default(false) vegan Boolean @default(false) vegetarian Boolean @default(false) glutenFree Boolean @default(false) halal Boolean @default(false) publishedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) category Category? @relation(fields:[categoryId],references:[id]) services ListingService[] media ListingMedia[] quotes Quote[] favorites FavoriteListing[] @@index([status,cityId,categoryId,publishedAt]) @@index([companyId,status]) }
model ListingService { listingId String serviceId String listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade) service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) @@id([listingId,serviceId]) }
model ListingMedia { id String @id @default(cuid()) listingId String url String type String alt String? sortOrder Int @default(0) listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade) }
model Supplier { id String @id @default(cuid()) name String slug String @unique description String? categoryId String? cityId String? website String? verified Boolean @default(false) category SupplierCategory? @relation(fields:[categoryId],references:[id]) listings ListingSupplier[] }
model SupplierCategory { id String @id @default(cuid()) name String slug String @unique suppliers Supplier[] }
model ListingSupplier { listingId String supplierId String relationshipType String? listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade) supplier Supplier @relation(fields:[supplierId],references:[id],onDelete:Cascade) companyId String? company Company? @relation(fields:[companyId],references:[id]) @@id([listingId,supplierId]) }
model City { id String @id @default(cuid()) name String slug String @unique districts District[] companies Company[] listings Listing[] }
model District { id String @id @default(cuid()) name String slug String cityId String city City @relation(fields:[cityId],references:[id],onDelete:Cascade) companies Company[] listings Listing[] @@unique([cityId,slug]) }
model Lead { id String @id @default(cuid()) customerId String title String eventDate DateTime? eventType String? address String? cityId String? districtId String? people Int? budgetMin Decimal? budgetMax Decimal? requirements Json? notes String? status LeadStatus @default(OPEN) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt customer User @relation(fields:[customerId],references:[id]) matches LeadCompanyMatch[] quotes Quote[] @@index([customerId,status]) }
model LeadCompanyMatch { leadId String companyId String score Float matchedAt DateTime @default(now()) viewedAt DateTime? lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade) company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) @@id([leadId,companyId]) @@index([companyId,matchedAt]) }
model Quote { id String @id @default(cuid()) leadId String companyId String customerId String total Decimal perPerson Decimal? menu Json? includedServices Json? tax Decimal? discount Decimal? validUntil DateTime? description String? status QuoteStatus @default(DRAFT) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade) company Company @relation(fields:[companyId],references:[id]) customer User @relation(fields:[customerId],references:[id]) items QuoteItem[] history QuoteStatusHistory[] attachments QuoteAttachment[] @@index([customerId,status]) @@index([companyId,status]) }
model QuoteItem { id String @id @default(cuid()) quoteId String name String quantity Float unitPrice Decimal total Decimal quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade) }
model QuoteAttachment { id String @id @default(cuid()) quoteId String url String filename String quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade) }
model QuoteStatusHistory { id String @id @default(cuid()) quoteId String fromStatus QuoteStatus? toStatus QuoteStatus actorId String createdAt DateTime @default(now()) quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade) }
model Conversation { id String @id @default(cuid()) leadId String? quoteId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt participants ConversationParticipant[] messages Message[] }
model ConversationParticipant { conversationId String userId String conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@id([conversationId,userId]) }
model Message { id String @id @default(cuid()) conversationId String senderId String text String? type String @default("text") status String @default("SENT") createdAt DateTime @default(now()) conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade) sender User @relation(fields:[senderId],references:[id]) attachments MessageAttachment[] @@index([conversationId,createdAt]) }
model MessageAttachment { id String @id @default(cuid()) messageId String url String filename String message Message @relation(fields:[messageId],references:[id],onDelete:Cascade) }
model Review { id String @id @default(cuid()) companyId String customerId String rating Int title String? body String? foodQuality Int? presentation Int? service Int? punctuality Int? communication Int? value Int? eventType String? eventDate DateTime? people Int? status ReviewStatus @default(PENDING) createdAt DateTime @default(now()) company Company @relation(fields:[companyId],references:[id]) customer User @relation(fields:[customerId],references:[id]) reply ReviewReply? }
model ReviewReply { id String @id @default(cuid()) reviewId String @unique companyId String body String createdAt DateTime @default(now()) review Review @relation(fields:[reviewId],references:[id],onDelete:Cascade) company Company @relation(fields:[companyId],references:[id]) }
model FavoriteCompany { userId String companyId String createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) @@id([userId,companyId]) }
model FavoriteListing { userId String listingId String createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade) @@id([userId,listingId]) }
model Notification { id String @id @default(cuid()) userId String type NotificationType title String body String readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,readAt,createdAt]) }
model NotificationPreference { id String @id @default(cuid()) userId String @unique email Boolean @default(true) push Boolean @default(true) inApp Boolean @default(true) user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model ExternalReviewSource { id String @id @default(cuid()) name String @unique }
model ExternalReview { id String @id @default(cuid()) companyId String sourceId String externalId String? authorName String? rating Float? body String? publishedAt DateTime? sourceUrl String? company Company @relation(fields:[companyId],references:[id]) source ExternalReviewSource @relation(fields:[sourceId],references:[id]) @@unique([sourceId,externalId]) }
model GooglePlace { id String @id @default(cuid()) companyId String @unique placeId String rating Float? reviewCount Int? mapsUrl String? company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) }
model YandexPlace { id String @id @default(cuid()) companyId String @unique externalId String? rating Float? reviewCount Int? mapsUrl String? company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) }
model SearchEvent { id String @id @default(cuid()) query String normalizedQuery String sessionId String userId String? device String? location String? resultCount Int clickedResultId String? clickedResultType String? createdAt DateTime @default(now()) @@index([normalizedQuery,createdAt]) }
model TrafficSession { id String @id @default(cuid()) sessionId String @unique userId String? referrer String? landingPage String? utmSource String? utmMedium String? utmCampaign String? utmContent String? utmTerm String? gclid String? msclkid String? device String? browser String? os String? country String? city String? firstTouch DateTime @default(now()) lastTouch DateTime @updatedAt }
model AnalyticsEvent { id String @id @default(cuid()) name String sessionId String userId String? entityType String? entityId String? properties Json? createdAt DateTime @default(now()) @@index([name,createdAt]) }
model SearchConsoleProperty { id String @id @default(cuid()) siteUrl String @unique connectedAt DateTime? lastSyncedAt DateTime? queryStats SearchConsoleQueryStat[] pageStats SearchConsolePageStat[] syncLogs SearchConsoleSyncLog[] }
model SearchConsoleQueryStat { id String @id @default(cuid()) propertyId String query String date DateTime clicks Int impressions Int ctr Float position Float device String? country String? property SearchConsoleProperty @relation(fields:[propertyId],references:[id],onDelete:Cascade) @@unique([propertyId,query,date,device,country]) }
model SearchConsolePageStat { id String @id @default(cuid()) propertyId String page String date DateTime clicks Int impressions Int ctr Float position Float device String? country String? property SearchConsoleProperty @relation(fields:[propertyId],references:[id],onDelete:Cascade) @@unique([propertyId,page,date,device,country]) }
model SearchConsoleSyncLog { id String @id @default(cuid()) propertyId String startedAt DateTime @default(now()) finishedAt DateTime? status String error String? property SearchConsoleProperty @relation(fields:[propertyId],references:[id],onDelete:Cascade) }
model YandexWebmasterProperty { id String @id @default(cuid()) siteUrl String @unique connectedAt DateTime? lastSyncedAt DateTime? queryStats YandexQueryStat[] syncLogs YandexSyncLog[] }
model YandexQueryStat { id String @id @default(cuid()) propertyId String query String date DateTime clicks Int impressions Int ctr Float position Float device String? property YandexWebmasterProperty @relation(fields:[propertyId],references:[id],onDelete:Cascade) @@unique([propertyId,query,date,device]) }
model YandexSyncLog { id String @id @default(cuid()) propertyId String startedAt DateTime @default(now()) finishedAt DateTime? status String error String? property YandexWebmasterProperty @relation(fields:[propertyId],references:[id],onDelete:Cascade) }
model SubscriptionPlan { id String @id @default(cuid()) code String @unique name String priceMonthly Decimal priceYearly Decimal trialDays Int @default(0) active Boolean @default(true) features Json limits Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt subscriptions CompanySubscription[] }
model CompanySubscription { id String @id @default(cuid()) companyId String planId String status SubscriptionStatus startedAt DateTime @default(now()) renewsAt DateTime? cancelledAt DateTime? provider String? providerSubscriptionId String? company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) plan SubscriptionPlan @relation(fields:[planId],references:[id]) payments SubscriptionPayment[] @@index([companyId,status]) }
model SubscriptionPayment { id String @id @default(cuid()) subscriptionId String amount Decimal currency String @default("TRY") status String provider String? providerPaymentId String? idempotencyKey String @unique createdAt DateTime @default(now()) subscription CompanySubscription @relation(fields:[subscriptionId],references:[id],onDelete:Cascade) }
model Payment { id String @id @default(cuid()) companyId String? amount Decimal currency String status String provider String? providerPaymentId String? idempotencyKey String @unique createdAt DateTime @default(now()) company Company? @relation(fields:[companyId],references:[id]) }
model Invoice { id String @id @default(cuid()) companyId String? subscriptionPaymentId String? number String @unique amount Decimal currency String @default("TRY") issuedAt DateTime @default(now()) pdfUrl String? company Company? @relation(fields:[companyId],references:[id]) }
model BlogCategory { id String @id @default(cuid()) name String slug String @unique posts BlogPost[] }
model BlogPost { id String @id @default(cuid()) title String slug String @unique excerpt String? content String coverUrl String? authorId String categoryId String? status String @default("DRAFT") seoTitle String? metaDescription String? canonical String? publishedAt DateTime? updatedAt DateTime @updatedAt author User @relation(fields:[authorId],references:[id]) category BlogCategory? @relation(fields:[categoryId],references:[id]) }
model BlogTag { id String @id @default(cuid()) name String slug String @unique }
model SeoPage { id String @id @default(cuid()) path String @unique title String description String? canonical String? noindex Boolean @default(false) schema Json? }
model SeoRedirect { id String @id @default(cuid()) fromPath String @unique toPath String statusCode Int @default(301) }
model SeoMeta { id String @id @default(cuid()) entityType String entityId String title String? description String? canonical String? @@unique([entityType,entityId]) }
model MediaAsset { id String @id @default(cuid()) ownerType String ownerId String key String @unique url String mimeType String size Int width Int? height Int? visibility String @default("PRIVATE") createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) actorId String? action String entity String entityId String? oldValue Json? newValue Json? ip String? correlationId String? createdAt DateTime @default(now()) @@index([entity,entityId,createdAt]) }
model Report { id String @id @default(cuid()) type String parameters Json? generatedBy String? url String? createdAt DateTime @default(now()) }
model SupportTicket { id String @id @default(cuid()) userId String subject String body String status String @default("OPEN") createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model SystemSetting { id String @id @default(cuid()) key String @unique value Json updatedAt DateTime @updatedAt }
