generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  name String
  phone String?
  role String @default("CUSTOMER")
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerProfile {
  id String @id @default(cuid())
  userId String @unique
  cityId String?
  districtId String?
  bio String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id String @id @default(cuid())
  name String
  slug String @unique
  status String @default("PENDING")
  verified Boolean @default(false)
  description String?
  foundedYear Int?
  cityId String?
  districtId String?
  address String?
  latitude Float?
  longitude Float?
  capacity Int?
  responseMinutes Int?
  rating Float @default(0)
  reviewCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model CompanyUser {
  companyId String
  userId String
  role String @default("OWNER")
  @@id([companyId, userId])
}

model CompanyProfile {
  id String @id @default(cuid())
  companyId String @unique
  logoUrl String?
  coverUrl String?
  website String?
  services Json?
  cuisines Json?
  serviceAreas Json?
  paymentOptions Json?
  completeness Int @default(0)
  seoTitle String?
  seoDescription String?
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  active Boolean @default(true)
}

model CompanyCategory {
  companyId String
  categoryId String
  @@id([companyId, categoryId])
}

model Listing {
  id String @id @default(cuid())
  companyId String
  categoryId String?
  cityId String?
  title String
  slug String @unique
  subtitle String?
  description String?
  status String @default("DRAFT")
  priceFrom Decimal?
  priceType String?
  minPeople Int?
  maxPeople Int?
  setup Boolean @default(false)
  staff Boolean @default(false)
  delivery Boolean @default(false)
  vegan Boolean @default(false)
  vegetarian Boolean @default(false)
  glutenFree Boolean @default(false)
  halal Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ListingMedia {
  id String @id @default(cuid())
  listingId String
  url String
  type String
  alt String?
  sortOrder Int @default(0)
}

model City {
  id String @id @default(cuid())
  name String
  slug String @unique
}

model SubscriptionPlan {
  id String @id @default(cuid())
  code String @unique
  name String
  priceMonthly Decimal
  priceYearly Decimal
  trialDays Int @default(0)
  active Boolean @default(true)
  features Json
  limits Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
